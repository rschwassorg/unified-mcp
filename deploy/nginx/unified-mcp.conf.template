worker_processes  1;
error_log  logs/unified-mcp-error.log warn;
pid        logs/unified-mcp.pid;

events { worker_connections 1024; }

http {
    include       mime.types;
    default_type  application/octet-stream;
    access_log    logs/unified-mcp-access.log;
    sendfile      on;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen 9443 ssl;
        server_name localhost;

        ssl_certificate     __CERTIFICATE__;
        ssl_certificate_key __PRIVATE_KEY__;
        ssl_protocols       TLSv1.2 TLSv1.3;

        location = /bridge {
            proxy_pass http://127.0.0.1:18765;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_read_timeout 75s;
        }

        location / {
            proxy_pass http://127.0.0.1:18766;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Authorization $http_authorization;
            proxy_buffering off;
            client_max_body_size 1m;
        }
    }
}
