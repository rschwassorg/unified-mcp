{
  "manifest_version": 3,
  "name": "Chrome MCP",
  "version": "0.2.0",
  "description": "Connect Chrome to a local Unified MCP server.",
  "permissions": [
    "activeTab",
    "alarms",
    "debugger",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Chrome MCP"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
